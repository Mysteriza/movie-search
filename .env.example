# === OMDb API Configuration (Required) ===
# Get free API key at: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key_here

# === TMDb API Configuration (Required for Trending Movies) ===
TMDB_API_KEY=your_tmdb_api_key_here

# === Flask Configuration ===
# Options: production (default) or development
FLASK_ENV=production

# Optional: Auto-generated via secrets.token_hex(32) if left empty
SECRET_KEY=
